{
  "name": "INOVEX Task Manager",
  "short_name": "INOVEX Tasks",
  "description": "Daily tasks for the INOVEX management team, linked to Gmail, Calendar, Meet and Google Tasks.",
  "id": "./",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#121212",
  "theme_color": "#121212",
  "lang": "en",
  "dir": "auto",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Install help", "short_name": "Help", "url": "./install.html", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
